@page "/admin"
@implements IDisposable

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using ToolHub.Domain.Models
@using ToolHub.State

@inject ToolHub.Infrastructure.SharePoint.SharePointToolRequestReader RequestReader
@inject ToolHub.Infrastructure.SharePoint.SharePointAdminService AdminService
@inject ToolHub.Infrastructure.SharePoint.SharePointAdminLockService AdminLockService
@inject ToolHub.Infrastructure.SharePoint.SharePointToolHistoryCleanupService HistoryCleanupService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject AdminRequestState AdminRequestState
@inject AdminRequestViewState ViewState

@if (isChecking)
{
    <section class="admin-shell">
        <div class="admin-empty">
            <h3>Checking permissions...</h3>
            <p>Please wait while your administrator access is being verified.</p>
        </div>
    </section>
}
else if (!isAdmin)
{
    <section class="admin-shell">
        <div class="admin-empty">
            <h3>Access denied</h3>
            <p>You do not have permission to access the administration panel.</p>
        </div>
    </section>
}
else if (isPanelLocked)
{
    <section class="admin-shell">
        <div class="admin-empty">
            <h3>Administration panel locked</h3>
            <p>@lockMessage</p>
        </div>
    </section>
}
else
{
    <section class="admin-shell">
        <div class="admin-header">
            <div>
                <p class="admin-eyebrow">Administration</p>
                <h1>@PageTitle</h1>
                <p class="admin-subtitle">@PageSubtitle</p>
            </div>

            <div class="admin-count">
                <span>@requests.Count</span>
                <small>@CounterLabel</small>
            </div>
        </div>

        @if (ViewState.IsHistory)
        {
            <div class="admin-history-toolbar" style="margin-bottom: 2rem;">
                <button class="admin-btn admin-btn-danger"
                        disabled="@(isClearingHistory || requests.Count == 0)"
                        @onclick="ClearHistoryAsync">
                    @(isClearingHistory ? "Clearing history..." : "Clear history")
                </button>

                @if (!string.IsNullOrWhiteSpace(historyCleanupMessage))
                {
                    <span class="admin-history-message">
                        @historyCleanupMessage
                    </span>
                }
            </div>
        }

        @if (requests.Count == 0)
        {
            <div class="admin-empty">
                <h3>@EmptyTitle</h3>
                <p>@EmptyText</p>
            </div>
        }
        else if (ViewState.IsPending)
        {
            <div class="admin-request-grid">
                @foreach (var req in requests)
                {
                    <article class="@GetRequestCardClass(req)"
                             @onclick="() => SelectRequest(req)">
                        <div class="request-card-top">
                            <div>
                                <div class="request-id">@req.RequestId</div>
                                <h3>@req.Tool.Name</h3>
                                @if (string.Equals(req.Type, "UpdateTool", StringComparison.OrdinalIgnoreCase))
                                {
                                    <div style="margin-top:6px;"><span class="badge" style="background:#f0ad4e;color:#333;padding:4px 6px;border-radius:8px;font-size:12px;display:inline-block;white-space:normal;word-break:break-word;overflow-wrap:anywhere;max-width:120px;">Update request</span></div>
                                }
                            </div>
                            <span class="request-status">@req.Status</span>
                        </div>

                        <div class="request-meta">
                            <div>
                                <span>Category</span>
                                <strong>@req.Tool.Category</strong>
                            </div>
                            <div>
                                <span>Version</span>
                                <strong>
                                    @(string.Equals(req.Type, "UpdateTool", StringComparison.OrdinalIgnoreCase)
                                        ? (req.RequestedVersion ?? req.Tool.Version)
                                        : req.Tool.Version)
                                </strong>

                            </div>
                            <div>
                                <span>Requested at</span>
                                <strong>@req.RequestedAtUtc.LocalDateTime</strong>
                            </div>
                        </div>

                        <div class="request-user">
                            <span>Requested by</span>
                            <strong>@FormatRequesterDisplay(req.RequestedByName, req.RequestedByEmail)</strong>
                            <small class="text-wrap">@GetRequesterEmailDisplay(req.RequestedByName, req.RequestedByEmail)</small>
                        </div>

                        <div class="request-description">
                            <div class="request-desc-text text-wrap">@BreakLongTokens(req.Tool.Description)</div>
                            @if (string.Equals(req.Type, "UpdateTool", StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="request-extra" style="margin-top:8px;">
                                    <p class="text-wrap"> <strong>Requested version:</strong> @req.RequestedVersion</p>
                                    <p class="text-wrap"> <strong>Reason:</strong> @BreakLongTokens(req.Reason)</p>
                                    @if (!string.IsNullOrWhiteSpace(req.Notes))
                                    {
                                        <p class="text-wrap"><strong>Notes:</strong> @BreakLongTokens(req.Notes)</p>
                                    }
                                </div>
                            }
                        </div>

                        <div class="request-actions">
                            @if (!string.IsNullOrWhiteSpace(req.ApplicationReqFolderUrl))
                            {
                                <a class="admin-btn admin-btn-primary"
                                   href="@req.ApplicationReqFolderUrl"
                                   target="_blank"
                                   @onclick:stopPropagation="true">
                                    Open files folder
                                </a>
                            }
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="admin-request-grid">
                @foreach (var req in requests)
                {
                    <article class="@GetRequestCardClass(req) history-card"
                             @onclick="() => SelectRequest(req)">
                        <div class="request-card-top">
                            <div>
                                <div class="request-id">@req.RequestId</div>
                                <h3>@req.Tool.Name</h3>
                            </div>
                            <span class="@GetStatusClass(req.Status)">@req.Status</span>
                        </div>

                        <div class="request-meta">
                            <div>
                                <span>Category</span>
                                <strong>@req.Tool.Category</strong>
                            </div>
                            <div>
                                <span>Version</span>
                                <strong>
                                    @(string.Equals(req.Type, "UpdateTool", StringComparison.OrdinalIgnoreCase)
                                        ? (req.RequestedVersion ?? req.Tool.Version)
                                        : req.Tool.Version)
                                </strong>

                            </div>
                            <div>
                                <span>Processed at</span>
                                <strong>@GetProcessedAt(req)</strong>
                            </div>
                        </div>

                        <div class="request-user">
                            <span>Requested by</span>
                            <strong>@FormatRequesterDisplay(req.RequestedByName, req.RequestedByEmail)</strong>
                            <small class="text-wrap">@GetRequesterEmailDisplay(req.RequestedByName, req.RequestedByEmail)</small>
                        </div>

                        <div class="request-user">
                            <span>@GetProcessedByLabel(req)</span>
                            <strong>@GetProcessedByName(req)</strong>
                        </div>

                        <p class="request-description">
                            @req.Tool.Description
                        </p>
                        <div class="request-description">
                            <div class="request-desc-text text-wrap">@BreakLongTokens(req.Tool.Description)</div>
                            @if (string.Equals(req.Type, "UpdateTool", StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="request-extra" style="margin-top:8px;">
                                    <p class="text-wrap"><strong>Requested version:</strong> @req.RequestedVersion</p>
                                    <p class="text-wrap"><strong>Reason:</strong> @BreakLongTokens(req.Reason)</p>
                                    @if (!string.IsNullOrWhiteSpace(req.Notes))
                                    {
                                        <p class="text-wrap"><strong>Notes:</strong> @BreakLongTokens(req.Notes)</p>
                                    }
                                </div>
                            }
                        </div>

                        <div class="request-actions">
                            @if (IsApproved(req) && !string.IsNullOrWhiteSpace(req.ApprovedToolId))
                            {
                                <span class="admin-history-note">
                                    Tool ID: @req.ApprovedToolId
                                </span>
                            }

                            @if (IsRejected(req) && !string.IsNullOrWhiteSpace(req.RejectedFolderUrl))
                            {
                                <a class="admin-btn admin-btn-primary"
                                   href="@req.RejectedFolderUrl"
                                   target="_blank"
                                   @onclick:stopPropagation="true">
                                    Open rejected folder
                                </a>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </section>
}

@code {
    private static readonly TimeSpan HeartbeatInterval = TimeSpan.FromMinutes(5);

    private static string BreakLongTokens(string? text, int chunk = 40)
    {
        if (string.IsNullOrEmpty(text))
            return string.Empty;

        return System.Text.RegularExpressions.Regex.Replace(text, "(\\S{" + chunk + "})", "$1\u200B");
    }

    private static string FormatRequesterDisplay(string? name, string? email)
    {
        // Prefer an explicit readable name when available
        if (!string.IsNullOrWhiteSpace(name) && !name.Contains("@"))
            return name!;

        // If name looks like an email but email field is empty, derive display from name
        if (!string.IsNullOrWhiteSpace(name) && name.Contains("@") && string.IsNullOrWhiteSpace(email))
        {
            var local = name.Split('@')[0];
            local = local.Replace('.', ' ').Replace('_', ' ').Trim();
            if (string.IsNullOrEmpty(local))
                return name!;

            return System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(local);
        }

        // If name is missing but email is present, derive from email local-part
        if (string.IsNullOrWhiteSpace(name) && !string.IsNullOrWhiteSpace(email))
        {
            var local = email.Split('@')[0];
            local = local.Replace('.', ' ').Replace('_', ' ').Trim();
            if (string.IsNullOrEmpty(local))
                return email!;

            return System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(local);
        }

        // Fallback: show email if available, otherwise Unknown
        if (!string.IsNullOrWhiteSpace(email))
            return email!;

        return "Unknown";
    }

    private static string GetRequesterEmailDisplay(string? name, string? email)
    {
        // Prefer explicit email when available
        if (!string.IsNullOrWhiteSpace(email))
            return email!;

        // If email missing but name looks like an email, return that
        if (!string.IsNullOrWhiteSpace(name) && name.Contains("@"))
            return name!;

        return string.Empty;
    }

    private static bool ShouldShowEmailBelow(string? name, string? email)
    {
        if (string.IsNullOrWhiteSpace(email))
            return false;

        // show email under the name only when an explicit non-email name was provided
        if (string.IsNullOrWhiteSpace(name))
            return false;

        if (name.Contains("@"))
            return false;

        return !string.Equals(name.Trim(), email.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    private IReadOnlyList<ToolRequestEntry> requests = [];

    private bool isChecking = true;
    private bool isAdmin = false;
    private bool isPanelLocked = false;
    private bool isClearingHistory = false;

    private string currentAdminOid = string.Empty;
    private string currentAdminName = string.Empty;
    private string lockMessage = string.Empty;
    private string? historyCleanupMessage;

    private CancellationTokenSource? heartbeatCts;
    private Task? heartbeatTask;

    private string PageTitle => ViewState.IsPending
        ? "Pending requests"
        : "History";

    private string PageSubtitle => ViewState.IsPending
        ? "Review submitted tool requests."
        : "Approved and rejected requests.";

    private string CounterLabel => ViewState.IsPending ? "pending" : "history";
    private string EmptyTitle => ViewState.IsPending ? "No requests found" : "No history";
    private string EmptyText => ViewState.IsPending
        ? "There are currently no pending tool requests."
        : "There are no approved or rejected requests.";

    protected override void OnInitialized()
    {
        AdminRequestState.RefreshRequested += OnRefreshRequested;
        ViewState.Changed += OnViewStateChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        currentAdminOid = GetOid(user);
        currentAdminName = GetDisplayName(user);

        isAdmin = await AdminService.IsAdminAsync(
            currentAdminOid,
            CancellationToken.None);

        if (!isAdmin)
        {
            isChecking = false;
            return;
        }

        var lockResult = await AdminLockService.TryAcquireAsync(
            currentAdminOid,
            currentAdminName,
            CancellationToken.None);

        if (!lockResult.IsAcquired)
        {
            isPanelLocked = true;
            lockMessage = lockResult.Message ?? "Administration panel is currently locked by another administrator.";
            isChecking = false;
            return;
        }

        StartHeartbeat();

        await ReloadRequestsAsync();
        isChecking = false;
    }

    private void StartHeartbeat()
    {
        heartbeatCts?.Cancel();
        heartbeatCts?.Dispose();

        heartbeatCts = new CancellationTokenSource();
        heartbeatTask = RunHeartbeatAsync(heartbeatCts.Token);
    }

    private async Task RunHeartbeatAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(HeartbeatInterval);

        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                var result = await AdminLockService.TryAcquireAsync(
                    currentAdminOid,
                    currentAdminName,
                    ct);

                if (!result.IsAcquired)
                {
                    isPanelLocked = true;
                    lockMessage = result.Message ?? "Administration panel lock was lost.";
                    AdminRequestState.Clear();

                    await InvokeAsync(StateHasChanged);
                    return;
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Expected when component is disposed.
        }
        catch (Exception ex)
        {
            isPanelLocked = true;
            lockMessage = $"Administration lock heartbeat failed: {ex.Message}";
            AdminRequestState.Clear();

            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ReloadRequestsAsync()
    {
        requests = ViewState.IsPending
            ? await RequestReader.ListPendingAsync(CancellationToken.None)
            : await RequestReader.ListHistoryAsync(CancellationToken.None);
    }

    private async Task ClearHistoryAsync()
    {
        if (!ViewState.IsHistory)
            return;

        if (isClearingHistory)
            return;

        if (requests.Count == 0)
            return;

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "This will permanently delete all history request JSON files and rejected archive folders. Approved tools and Application Source folders will NOT be deleted. Continue?");

        if (!confirmed)
            return;

        try
        {
            isClearingHistory = true;
            historyCleanupMessage = null;
            AdminRequestState.Clear();

            var result = await HistoryCleanupService.ClearHistoryAsync(CancellationToken.None);

            await ReloadRequestsAsync();

            historyCleanupMessage = result.HasErrors
                ? $"    History cleared with errors. Deleted request JSON: {result.DeletedRequestJsonCount}, deleted rejected folders: {result.DeletedRejectedFolderCount}, errors: {result.Errors.Count}."
                : $"    History cleared. Deleted request JSON: {result.DeletedRequestJsonCount}, deleted rejected folders: {result.DeletedRejectedFolderCount}.";
        }
        catch (Exception ex)
        {
            historyCleanupMessage = $"Clear history failed: {ex.Message}";
        }
        finally
        {
            isClearingHistory = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async void OnRefreshRequested()
    {
        if (!isAdmin || isPanelLocked)
            return;

        await ReloadRequestsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async void OnViewStateChanged()
    {
        if (!isAdmin || isPanelLocked)
            return;

        AdminRequestState.Clear();
        historyCleanupMessage = null;
        await ReloadRequestsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void SelectRequest(ToolRequestEntry request)
    {
        AdminRequestState.Select(request);
    }

    private string GetRequestCardClass(ToolRequestEntry request)
    {
        var isSelected =
            AdminRequestState.Selected?.RequestId == request.RequestId;

        return isSelected
            ? "admin-request-card selected"
            : "admin-request-card";
    }

    private static bool IsApproved(ToolRequestEntry request)
    {
        return string.Equals(request.Status, "Approved", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsRejected(ToolRequestEntry request)
    {
        return string.Equals(request.Status, "Rejected", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetStatusClass(string status)
    {
        if (string.Equals(status, "Approved", StringComparison.OrdinalIgnoreCase))
            return "request-status request-status-approved";

        if (string.Equals(status, "Rejected", StringComparison.OrdinalIgnoreCase))
            return "request-status request-status-rejected";

        return "request-status";
    }

    private static string GetProcessedAt(ToolRequestEntry request)
    {
        var processedAt = IsApproved(request)
            ? request.ApprovedAtUtc
            : request.RejectedAtUtc;

        return processedAt?.LocalDateTime.ToString() ?? "-";
    }

    private static string GetProcessedByLabel(ToolRequestEntry request)
    {
        return IsApproved(request)
            ? "Approved by"
            : "Rejected by";
    }

    private static string GetProcessedByName(ToolRequestEntry request)
    {
        if (IsApproved(request))
            return string.IsNullOrWhiteSpace(request.ApprovedByName) ? "-" : request.ApprovedByName!;

        return string.IsNullOrWhiteSpace(request.RejectedByName) ? "-" : request.RejectedByName!;
    }

    private static string GetOid(ClaimsPrincipal user)
    {
        return user.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value
            ?? user.FindFirst("oid")?.Value
            ?? string.Empty;
    }

    private static string GetDisplayName(ClaimsPrincipal user)
    {
        return user.FindFirst("name")?.Value
            ?? user.Identity?.Name
            ?? "Unknown admin";
    }

    public void Dispose()
    {
        AdminRequestState.RefreshRequested -= OnRefreshRequested;
        ViewState.Changed -= OnViewStateChanged;
        AdminRequestState.Clear();

        heartbeatCts?.Cancel();
        heartbeatCts?.Dispose();

        if (!string.IsNullOrWhiteSpace(currentAdminOid) && isAdmin && !isPanelLocked)
        {
            _ = AdminLockService.ReleaseAsync(
                currentAdminOid,
                CancellationToken.None);
        }
    }
}
