    private void AddChangeLogEntry()
    {
        if (editChangeLog == null)
            editChangeLog = new List<EditChangeLogItem>();

        editChangeLog.Insert(0, new EditChangeLogItem { CreatedAtUtc = DateTimeOffset.UtcNow });
        _ = InvokeAsync(StateHasChanged);
    }

    private void RemoveChangeLogEntry(EditChangeLogItem item)
    {
        if (editChangeLog == null)
            return;

        // Remove matching item and refresh UI
        var removed = editChangeLog.Remove(item);
        if (removed)
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private void RemoveChangeLogEntryAt(int index)
    {
        if (editChangeLog == null)
            return;

        if (index < 0 || index >= editChangeLog.Count)
            return;

        editChangeLog.RemoveAt(index);
        _ = InvokeAsync(StateHasChanged);
    }

